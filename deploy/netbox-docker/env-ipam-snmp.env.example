# ===== IPAM SNMPv3 수집 계정 =====
# 이 파일을 netbox-docker/env/ipam-snmp.env 로 복사한 뒤 값을 바꾸세요.
# (비밀번호가 들어가므로 다른 사람과 공유하거나 Git에 올리지 마세요)
IPAM_SNMP_USER=ipam-ro
IPAM_SNMP_AUTH=여기에_인증비밀번호
IPAM_SNMP_PRIV=여기에_암호화비밀번호
IPAM_SNMP_AUTH_PROTO=sha
IPAM_SNMP_PRIV_PROTO=aes

# 일부 장비만 계정이 다르면 두 번째 계정(없으면 지우거나 비워 두기)
#IPAM_SNMP_USER_2=
#IPAM_SNMP_AUTH_2=
#IPAM_SNMP_PRIV_2=

# 자동 수집 주기(분). 0 이면 자동 수집 끔(웹 스크립트로 수동 수집만)
IPAM_SNMP_INTERVAL=5
# 동시에 수집할 장비 수
IPAM_SNMP_CONCURRENCY=20

# 수집할 때마다 대장에 없는 단말 IP를 '자동 발견'으로 IP 주소 목록에 등록 (1=켬, 0=끔)
IPAM_AUTO_REGISTER=1
